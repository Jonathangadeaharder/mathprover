# MathProver — environment template (copy to .env and export)

# Path to this repository (auto-detected from mathprover-ui/ when unset)
# MATHPROVER_HOME=/path/to/mathprover

# Default Lean project opened by the UI
MATHPROVER_PROJECT_PATH=/path/to/lean-runtime-analysis

# Optional colon-separated allowlist for the project picker
# MATHPROVER_ALLOWED_ROOTS=$HOME/projects

# Required for Goedel dispatch (set in the Lean project's mathprover.toml too)
GOEDEL_PROVER_PATH=/path/to/goedel-prover-v2-32b/run.sh

# Required for Aristotle cloud dispatch
# ARISTOTLE_API_KEY=
